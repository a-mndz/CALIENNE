# aetheris — example environment file
#
# Copy to .env and fill in. `.env` is gitignored; this template is not.
#     cp .env.example .env
#
# Variable names are NOT uniform, because core/config.py mixes three styles.
# The name below each field is the exact one pydantic-settings reads
# (case_sensitive=True — casing matters):
#   * AETHERIS_* — the default prefix for fields with no validation_alias
#   * bare names — fields whose validation_alias omits the prefix
#   * aetheris_* — two legacy lowercase aliases (see the JWT section)
# Copy the names verbatim rather than normalising the case.


# ── Required ─────────────────────────────────────────────────────────────
# Signing key for session JWTs. Minimum 32 characters. Startup refuses an
# empty value, "change-me", and the old hardcoded demo key (CRIT-005),
# because a known key means anyone can forge a token.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AETHERIS_JWT_SECRET_KEY=

# ── Provider API keys ────────────────────────────────────────────────────
# All optional. Leave blank to run in Simulation Mode.
# CRIT-007 guard: a key starting with a known live prefix (sk-or-v1-,
# sk-proj-, nvapi-, gsk_p, github_pat_, …) is refused on load. Real keys
# belong in the OS secret store via secrets_bootstrap.py. To load a live key
# from the environment anyway, set AETHERIS_ALLOW_LIVE_KEYS=1 — it is logged
# on every startup, never silent.
AETHERIS_OPENROUTER_API_KEY=
AETHERIS_NVIDIA_NIM_API_KEY=
AETHERIS_GROQ_API_KEY=
AETHERIS_GITHUB_TOKEN=
AETHERIS_MISTRAL_API_KEY=
AETHERIS_GOOGLE_API_KEY=
AETHERIS_OPENAI_API_KEY=
AETHERIS_KIE_API_KEY=
AETHERIS_UNLI_DEV_API_KEY=

# ── Database (no AETHERIS_ prefix — bare names) ──────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aetheris
# Off by default so local development needs no certificates.
# Production MUST set this to true.
DATABASE_SSL=false

# ── HTTP / auth ──────────────────────────────────────────────────────────
# Comma-separated explicit origin allowlist. "*" is rejected: a wildcard
# combined with credentialed requests is forbidden by the CORS spec (CRIT-004).
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
AETHERIS_AUTH_COOKIE_NAME=aetheris_auth
# Per-IP cap on /auth/login and /auth/register requests per minute (HIGH-014).
AETHERIS_AUTH_RATE_LIMIT_PER_MINUTE=5
# Breaker gate budget in ms. 100 (default) fits simulation mode only — a live
# LLM round-trip needs ~5000-8000. On expiry the gate fails OPEN (pipeline
# continues): a slow breaker is an infrastructure artifact, not knowledge
# absence. Set to 8000 for live captures/deploys.
#AETHERIS_BREAKER_TIMEOUT_MS=100

# ── JWT tuning (lowercase prefix — legacy validation_alias) ─────────────
# These two really are lowercase. Note: on Windows the process environment is
# case-insensitive, so exporting them in a shell cannot work — set them here in
# .env, which pydantic-settings reads case-sensitively.
AETHERIS_JWT_ALGORITHM=HS256
AETHERIS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Runtime environment ──────────────────────────────────────────────────
# development | test | production. Drives security defaults: production
# switches logs to JSON with tracebacks stripped of locals, and makes the
# /metrics token mandatory.
AETHERIS_ENVIRONMENT=development

# ── Observability ────────────────────────────────────────────────────────
# Bearer token for scraping GET /metrics. Prometheus cannot present the
# httpOnly JWT cookie the admin routes use, so the scrape path has its own
# credential. Mandatory in production — unset there and the endpoint refuses
# to serve. Blank outside production leaves it open for local scraping.
AETHERIS_METRICS_TOKEN=
AETHERIS_LOG_LEVEL=INFO
# Only consulted by the plain-text fallback in configure_logging() when
# structlog is unavailable; the structlog renderers ignore it.
AETHERIS_LOG_FORMAT=%(asctime)s | %(name)-25s | %(levelname)-8s | %(message)s
# Writes full prompts and responses to logs/model_io.log. Off by default:
# model I/O routinely contains whatever the user pasted in.
AETHERIS_LOG_MODEL_IO=false

# ── Local fallback models ────────────────────────────────────────────────
# Hard ceiling on VRAM for local models, in MB. 6144 (6 GB) is both the
# default and the maximum accepted value — a larger number is rejected
# rather than clamped.
AETHERIS_LOCAL_MODEL_VRAM_LIMIT_MB=6144

# ── Custom gateway (read by the vault UI, prefix optional) ───────────────
# Key for a custom endpoint or local LLM (Ollama / vLLM / LiteLLM). Read as
# AETHERIS_CUSTOM_GATEWAY_KEY first, then CUSTOM_GATEWAY_KEY (server.py).
#AETHERIS_CUSTOM_GATEWAY_KEY=

# ── Feature flags (orchestrator/feature_flags.py) ────────────────────────
# All 13 gates default OFF; precedence is env var > config/feature_flags.json
# > off. The DAG path stays parked until β data from the first live eval
# capture justifies a verdict. Truthy: 1/true/yes/on. Falsy: 0/false/no/off/
# unset. META_ESCALATION and SELF_LEARNING are v2-reserved: setting them
# logs a warning and has no runtime effect in v1. Uncomment to enable.
#AETHERIS_ENABLE_PLANNER=0
#AETHERIS_ENABLE_DAG=0
#AETHERIS_ENABLE_CONSENSUS=0
#AETHERIS_ENABLE_RAG=0
#AETHERIS_ENABLE_REPAIR=0
#AETHERIS_ENABLE_PREDICTION=0
#AETHERIS_ENABLE_CONTEXT=0
#AETHERIS_ENABLE_SKILLS=0
#AETHERIS_ENABLE_EXPERIENCE_DB=0
#AETHERIS_ENABLE_KNOWLEDGE_LAYER=0
#AETHERIS_ENABLE_REPLAY=0
#AETHERIS_ENABLE_META_ESCALATION=0
#AETHERIS_ENABLE_SELF_LEARNING=0

# ── Operational tuning (read via os.environ, not Settings) ───────────────
# OS keyring service name for secrets_bootstrap.py key storage.
#AETHERIS_KEYRING_SERVICE=Aetheris
# Directory override for api_gateway/capabilities.py config files
# (pricing.json, model_capabilities.json, provider_limits.json).
#AETHERIS_CAPABILITIES_PATH=
# Directory override for the versioned agent prompt templates.
#AETHERIS_PROMPT_VERSIONS_PATH=
# Days an execution replay is retained before cleanup (execution_replay.py,
# RFC-004 §6.3 default: 30).
#AETHERIS_REPLAY_RETENTION_DAYS=30
# RFC-004 retrieval blend weights. JSON env wins, then a JSON file path,
# then the built-in defaults (relevance 0.40 / credibility 0.25 /
# freshness 0.15 / consensus 0.20).
#AETHERIS_RETRIEVAL_WEIGHTS_JSON=
#AETHERIS_RETRIEVAL_WEIGHTS_PATH=
# Commit SHA stamped into version metadata (orchestrator/versioning.py);
# auto-detected from git when unset.
#AETHERIS_GIT_COMMIT=
