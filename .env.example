# Calienne — example environment file
#
# Copy to .env and fill in. `.env` is gitignored; this template is not.
#     cp .env.example .env
#
# Prefix: CALIENNE_* (canonical). CALIENNE_* is also supported for backward compatibility.


# ── Required ─────────────────────────────────────────────────────────────
# Signing key for session JWTs. Minimum 32 characters.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CALIENNE_JWT_SECRET_KEY=

# ── Provider API keys ────────────────────────────────────────────────────
# All optional. Leave blank to run in Simulation Mode.
# Real keys belong in the OS secret store via secrets_bootstrap.py.
# To load a live key from the environment, set CALIENNE_ALLOW_LIVE_KEYS=1.
CALIENNE_OPENROUTER_API_KEY=
CALIENNE_NVIDIA_NIM_API_KEY=
CALIENNE_GROQ_API_KEY=
CALIENNE_GITHUB_TOKEN=
CALIENNE_MISTRAL_API_KEY=
CALIENNE_GOOGLE_API_KEY=
CALIENNE_OPENAI_API_KEY=
CALIENNE_KIE_API_KEY=
CALIENNE_UNLI_DEV_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/calienne
DATABASE_SSL=false

# ── HTTP / auth ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
CALIENNE_AUTH_COOKIE_NAME=calienne_auth
CALIENNE_AUTH_RATE_LIMIT_PER_MINUTE=5
#CALIENNE_BREAKER_TIMEOUT_MS=100

# ── JWT tuning ───────────────────────────────────────────────────────────
CALIENNE_JWT_ALGORITHM=HS256
CALIENNE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Runtime environment ──────────────────────────────────────────────────
CALIENNE_ENVIRONMENT=development

# ── Observability ────────────────────────────────────────────────────────
CALIENNE_METRICS_TOKEN=
CALIENNE_LOG_LEVEL=INFO
CALIENNE_LOG_FORMAT=%(asctime)s | %(name)-25s | %(levelname)-8s | %(message)s
CALIENNE_LOG_MODEL_IO=false

# ── Local fallback models ────────────────────────────────────────────────
CALIENNE_LOCAL_MODEL_VRAM_LIMIT_MB=6144

# ── Custom gateway ───────────────────────────────────────────────────────
#CALIENNE_CUSTOM_GATEWAY_KEY=

# ── Feature flags (orchestrator/feature_flags.py) ────────────────────────
# All gates default OFF.
#CALIENNE_ENABLE_PLANNER=0
#CALIENNE_ENABLE_DAG=0
#CALIENNE_ENABLE_CONSENSUS=0
#CALIENNE_ENABLE_RAG=0
#CALIENNE_ENABLE_REPAIR=0
#CALIENNE_ENABLE_PREDICTION=0
#CALIENNE_ENABLE_CONTEXT=0
#CALIENNE_ENABLE_SKILLS=0
#CALIENNE_ENABLE_EXPERIENCE_DB=0
#CALIENNE_ENABLE_KNOWLEDGE_LAYER=0
#CALIENNE_ENABLE_REPLAY=0
#CALIENNE_ENABLE_META_ESCALATION=0
#CALIENNE_ENABLE_SELF_LEARNING=0

# ── Operational tuning ───────────────────────────────────────────────────
#CALIENNE_KEYRING_SERVICE=Calienne
#CALIENNE_CAPABILITIES_PATH=
#CALIENNE_PROMPT_VERSIONS_PATH=
#CALIENNE_REPLAY_RETENTION_DAYS=30
#CALIENNE_RETRIEVAL_WEIGHTS_JSON=
#CALIENNE_RETRIEVAL_WEIGHTS_PATH=
#CALIENNE_GIT_COMMIT=

